## .gitignore for .NET 10 / Visual Studio
## Based on the github/gitignore VisualStudio template, plus .env and modern .NET additions

# ===== Secrets & environment (keep out of source control) =====
.env
.env.*
!.env.example
appsettings.Development.local.json
appsettings.*.local.json
secrets.json
*.pfx
*.snk

# ===== Visual Studio user-specific files =====
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# ===== Build results =====
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
artifacts/
out/

# .NET 10 / MSBuild
*.binlog
msbuild.log
msbuild.err
msbuild.wrn
project.lock.json
project.fragment.lock.json
*.nuget.props
*.nuget.targets
launchSettings.json.bak

# ===== Visual Studio cache / options =====
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user
.idea/
*.sln.iml
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/

# Visual Studio cache files
ipch/
*.aps
*.ncb
*.opendb
*.opensdf
*.sdf
*.cachefile
*.VC.db
*.VC.VC.opendb

# Visual Studio profiler / diagnostics
*.psess
*.vsp
*.vspx
*.sap
*.diagsession

# Code coverage
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
coverage*.info
TestResults/
[Tt]est[Rr]esult*/
*.trx
*.testsettings
*.runsettings.user
nunit-*.xml
[Bb]uild[Ll]og.*
.coverage/
coverage/
*.lcov

# Benchmark results
BenchmarkDotNet.Artifacts/

# NCrunch / dotCover / JetBrains
_NCrunch_*
.NCrunch_*
*.ncrunch*
*.dotCover

# ===== NuGet =====
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.dgspec.json

# ===== Publish output =====
PublishScripts/
*.[Pp]ublish.xml
*.azurePubxml
*.pubxml
*.publishproj

# ===== ASP.NET / web =====
node_modules/
wwwroot/lib/
.angular/
*.log
App_Data/*.mdf
App_Data/*.ldf

# ===== Azure / Functions =====
local.settings.json
.azure/
azd-env/
.azurefunctions/
bundles/
__azurite_db*__.json
__blobstorage__/
__queuestorage__/

# ===== Entity Framework / databases =====
*.mdf
*.ldf
*.ndf
*.sqlite
*.sqlite3
*.db
*.bak
*.dacpac
*.bacpac
Migrations/*.local.cs

# ===== ML.NET / AI development =====
*.mlnet
*.zip.bak
models/*.onnx
*.gguf
*.safetensors
.mcp/cache/
.semantic-kernel/

# ===== Docker / compose overrides =====
docker-compose.override.yml
docker-compose.local.yml

# ===== Rider / other IDEs =====
*.iml
.fleet/

# ===== Backup & temp files =====
*.tmp
*.temp
*.bak
*.orig
*.rej
*~
~$*
*.swp

# ===== OS files =====
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ===== Misc generated =====
*_i.c
*_p.c
*_h.h
*.ilk
*.meta
*.obj
*.pch
*.pdb
*.pgc
*.pgd
*.rsp
*.sbr
*.tlb
*.tli
*.tlh
*.tmp_proj
*.tlog
